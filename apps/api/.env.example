# Copie para .env (o comando `npm run setup` faz isso e gera a chave automaticamente).

# Porta da API
PORT=3333

# Banco de dados
#   SQLite local (padrão):  sqlite:./data/bancada.db
#   PostgreSQL (futuro):    postgres://usuario:senha@localhost:5432/bancada
DATABASE_URL=sqlite:./data/bancada.db

# Endereço do front, usado no CORS e para montar o link privado do cliente
WEB_ORIGIN=http://localhost:5173

# Chave de 32 bytes em hexadecimal (64 caracteres) usada para cifrar o link privado.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# MODO DEMONSTRAÇÃO: sem login, todas as requisições da oficina usam esta oficina.
# Não é seguro para produção. Ver README, seção "Segurança".
DEMO_WORKSHOP_ID=demo-workshop
